#!/usr/bin/env bash
# 1337-Customizer launcher.  Keeps the checkout relocatable, uses the Pixi
# environment when one is available, and falls back to the system Python.
set -euo pipefail
HERE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck source=scripts/env.sh
. "$HERE/scripts/env.sh"

MODE=auto
if [ -f "$HERE/.leet-install-mode" ]; then
  MODE=$(tr -d '[:space:]' < "$HERE/.leet-install-mode" 2>/dev/null || printf 'auto')
fi
if [ "${LEET_USE_SYSTEM:-0}" = "1" ]; then
  MODE=system
fi

if [ "$MODE" != "system" ] && [ -f "$HERE/pixi.toml" ]; then
  leet_prepare_pixi_config "$HERE"
  PIXI="$(leet_find_pixi || true)"
  if [ -n "$PIXI" ]; then
    if [ ! -e "$HERE/.pixi/envs/default" ]; then
      echo "1337-Customizer: preparing the Pixi environment (first run)…" >&2
      if ! "$PIXI" install --frozen --manifest-path "$HERE/pixi.toml" >/dev/null 2>&1; then
        "$PIXI" install --manifest-path "$HERE/pixi.toml" || true
      fi
    fi
    if [ -e "$HERE/.pixi/envs/default" ]; then
      exec "$PIXI" run --frozen --manifest-path "$HERE/pixi.toml" \
        python -m leet_customizer "$@"
    fi
    echo "1337-Customizer: Pixi environment unavailable; using system Python." >&2
  fi
fi

export PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}"
for candidate in \
  /usr/lib/girepository-1.0 \
  /usr/lib64/girepository-1.0 \
  /usr/lib/x86_64-linux-gnu/girepository-1.0 \
  /usr/local/lib/girepository-1.0; do
  if [ -d "$candidate" ]; then
    case ":${GI_TYPELIB_PATH:-}:" in
      *":$candidate:"*) ;;
      *) export GI_TYPELIB_PATH="${GI_TYPELIB_PATH:+$GI_TYPELIB_PATH:}$candidate" ;;
    esac
  fi
done

exec "${LEET_PYTHON:-python3}" -m leet_customizer "$@"
