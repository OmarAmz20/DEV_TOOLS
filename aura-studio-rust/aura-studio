#!/bin/sh
# Run Aura Studio from this folder, a checkout, or a symlink in ~/.local/bin.
# Prefer the Pixi environment created by install.sh; fall back to system Python.
set -e
SELF=$(readlink -f -- "$0" 2>/dev/null || printf '%s\n' "$0")
ROOT=$(CDPATH= cd -- "$(dirname -- "$SELF")" && pwd)
PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONPATH

# On 42-school machines goinfre is the big persistent mount.  Keep the Pixi
# environment, its package cache and Aura's thumbnail cache there when it
# exists; nothing changes on machines without ~/goinfre.
find_goinfre_root() {
    for base in "${AURA_GOINFRE:-}" "$HOME/goinfre"; do
        if [ -n "$base" ] && [ -d "$base" ] && [ -w "$base" ]; then
            printf '%s\n' "$base/aura-studio"
            return 0
        fi
    done
    return 1
}

if STORAGE_ROOT=$(find_goinfre_root); then
    mkdir -p "$STORAGE_ROOT/pixi" "$STORAGE_ROOT/cache"
    if [ -L "$ROOT/.pixi" ] && [ ! -e "$ROOT/.pixi" ]; then
        rm -f "$ROOT/.pixi"
    fi
    if [ ! -e "$ROOT/.pixi" ] && [ ! -L "$ROOT/.pixi" ]; then
        ln -s "$STORAGE_ROOT/pixi" "$ROOT/.pixi"
    fi
    : "${PIXI_HOME:=$STORAGE_ROOT/pixi-home}"
    : "${PIXI_CACHE_DIR:=$STORAGE_ROOT/pixi-cache}"
    : "${AURA_CACHE_DIR:=$STORAGE_ROOT/cache}"
    : "${CARGO_HOME:=$STORAGE_ROOT/cargo-home}"
    : "${CARGO_TARGET_DIR:=$STORAGE_ROOT/cargo-target}"
    export PIXI_HOME PIXI_CACHE_DIR AURA_CACHE_DIR CARGO_HOME CARGO_TARGET_DIR
fi

# If the checkout (or .pixi) was moved, Pixi refuses its old absolute prefix.
# Repair the text files in place instead of downloading the environment again.
if [ -f "$ROOT/.pixi/envs/default/conda-meta/pixi_env_prefix" ]; then
    python3 "$ROOT/scripts/fix-pixi-prefix.py" "$ROOT/.pixi/envs/default" \
        >/dev/null 2>&1 || true
fi

if [ ! -f "$ROOT/aura_core.abi3.so" ] && [ -f "$ROOT/Cargo.toml" ]; then
    printf '%s\n' \
        "Aura Studio: Rust core not built; using the Python fallback." \
        "             Run: pixi run build-rust" >&2
fi

MODE=pixi
if [ -f "$ROOT/.aura-install-mode" ]; then
    MODE=$(cat "$ROOT/.aura-install-mode" 2>/dev/null || printf 'pixi')
fi
if [ "${AURA_USE_SYSTEM:-0}" = "1" ]; then
    MODE=system
fi

if [ "$MODE" != "system" ]; then
    for pixi in "$(command -v pixi 2>/dev/null || true)" \
                "$HOME/.local/bin/pixi" \
                "$HOME/.pixi/bin/pixi"; do
        [ -n "$pixi" ] && [ -x "$pixi" ] || continue
        if [ ! -d "$ROOT/.pixi/envs/default" ]; then
            echo "Aura Studio: preparing the Pixi environment (first run)…" >&2
            if ! "$pixi" install --frozen --manifest-path "$ROOT/pixi.toml" >/dev/null 2>&1; then
                "$pixi" install --manifest-path "$ROOT/pixi.toml" || true
            fi
        fi
        if [ -d "$ROOT/.pixi/envs/default" ]; then
            exec "$pixi" run --frozen --manifest-path "$ROOT/pixi.toml" \
                python -m aura_studio "$@"
        fi
    done
fi

exec python3 -m aura_studio "$@"
